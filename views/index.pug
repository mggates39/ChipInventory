extends layout

block content
  p This is my hardware development lab management system

  div.row 
    div.col-sm-3
      div.card.text-center.border-dark.mb-3(style="max-width: 18rem;")
        h5.card-header.border-dark Definitions
        div.card-body
          p.card-title Component Definitions: #{data.definitions}
          for count in counts
            p.card-text 
              if count.ni == 1
                a(href="/components?component_type_id="+ count.id + "&q=&w=p" target="_blank") #{count.description}:
              else
                a(href="/components?component_type_id="+ count.id + "&q=&w=p" target="_blank") #{count.plural_description}:
              =count.ni
          for alias in aliases
            p.card-text 
              if alias.ni == 1
                a(href="/components?component_type_id="+ alias.id + "&q=see&w=k" target="_blank") #{alias.description}:
              else 
                a(href="/components?component_type_id="+ alias.id + "&q=see&w=k" target="_blank") #{alias.plural_description}:
              =alias.ni

    div.col-sm-3 
      div.card.text-center.border-dark.mb-3(style="max-width: 18rem;")
        h5.card-header.border-dark On Hand
        div.card-body
          p.card-title Components On Hand: #{data.on_hand}
          for item in inventory
            p.card-text #{item.quantity} from #{item.ni} 
             if item.ni == 1
              a(href="/inventory?component_type_id="+ item.id + "&q=&w=p" target="_blank") #{item.description}
             else
              a(href="/inventory?component_type_id="+ item.id + "&q=&w=p" target="_blank") #{item.plural_description}

    div.col-sm-3 
      div.card.text-center.border-dark.mb-3(style="max-width: 18rem;")
        h5.card-header.border-dark Date Range
        div.card-body
          p.card-title Component Dates
          p.card-text Oldest: #{data.min_date}
          p.card-text Newest: #{data.max_date}
  
    div.col-sm-3 
      div.card.text-center.border-dark.mb-3(style="max-width: 18rem;")
        h5.card-header.border-dark Manufacturers
        div.card-body
          p.card-title Manufacturer Counts
          p.card-text Manufacturers: #{data.mfgs}
          p.card-text Codes: #{data.codes}

    div.col-sm-3 
      div.card.text-center.border-dark.mb-3(style="max-width: 18rem;")
        h5.card-header.border-dark Locations
        div.card-body
          p.card-title Location Counts
          p.card-text Main Locations: #{data.main_locations}
          p.card-text Child Locations: #{data.child_locations}

    div.col-sm-3 
      div.card.text-center.border-dark.mb-3(style="max-width: 18rem;")
        h5.card-header.border-dark Projects
        div.card-body
          p.card-title Project Summaries
          p.card-text Projects: #{data.number_projects}
          p.card-text Needed Components: #{data.project_needed}
          p.card-text Available Components: #{data.project_available}
          p.card-text Missing Components: #{data.project_missing}
